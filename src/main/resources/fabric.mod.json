  "entrypoints": {
    "main": ["com.alejandro.retrogenmods.RetrogenMods"]
  },
  "depends": {
    "fabricloader": "*",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "ecologics": "*",
    "moogs_soaring_structures": "*"
  }
}
